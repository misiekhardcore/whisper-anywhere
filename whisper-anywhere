#!/usr/bin/python3
"""whisper-anywhere - Hold a hotkey, speak, release -> text appears.

Usage:
  whisper-anywhere                    # run with defaults (Ctrl+Super+Space)
  whisper-anywhere --hotkey KEY_F12   # use a single-key hotkey
  whisper-anywhere --model small      # use a different model size

Hotkey can be any KEY_ constant from linux/input-event-codes.h.
Common ones: KEY_F1..KEY_F12, KEY_GRAVE, KEY_SCROLLLOCK.

Config file at ~/.config/whisper-anywhere/config:
  hotkey=KEY_F12
  model=ggml-base.en.bin
"""

import asyncio
import subprocess
import signal
import os
import sys
import argparse
from evdev import InputDevice, list_devices, ecodes

CONFIG_DIR = os.path.expanduser("~/.config/whisper-anywhere")
MODEL_DIR = os.path.expanduser("~/.local/share/whisper/models")
DEFAULT_MODEL = "ggml-base.en.bin"
AUDIO = "/tmp/whisper-anywhere.wav"

CTRL = {ecodes.KEY_LEFTCTRL, ecodes.KEY_RIGHTCTRL}
SUPER = {ecodes.KEY_LEFTMETA, ecodes.KEY_RIGHTMETA}
SPACE = {ecodes.KEY_SPACE}
WANTED_MODS = CTRL | SUPER | SPACE


def find_keyboard():
    skip = {"ydotoold", "lid", "power", "sleep", "video"}
    for path in list_devices():
        dev = InputDevice(path)
        name = dev.name.lower()
        if any(s in name for s in skip):
            continue
        caps = dev.capabilities()
        if ecodes.EV_KEY in caps:
            keys = caps[ecodes.EV_KEY]
            if ecodes.KEY_A in keys and ecodes.KEY_B in keys and ecodes.KEY_SPACE in keys:
                return dev
    raise RuntimeError(
        "no suitable keyboard found. Make sure you're in the 'input' group"
        " and have a physical keyboard connected."
    )


def check_deps():
    missing = []
    for cmd in ("parec", "whisper-cli", "ydotool"):
        if not subprocess.run(["which", cmd], capture_output=True).returncode == 0:
            missing.append(cmd)
    if missing:
        print(f"Missing dependencies: {', '.join(missing)}", file=sys.stderr)
        print("Run the install script:", file=sys.stderr)
        print("  bash install.sh", file=sys.stderr)
        sys.exit(1)
    try:
        from evdev import InputDevice  # noqa: F401
    except ImportError:
        print("Missing python3-evdev. Run: pkexec apt install python3-evdev", file=sys.stderr)
        sys.exit(1)


def resolve_model(model_name):
    path = os.path.join(MODEL_DIR, model_name)
    if os.path.exists(path):
        return path
    print(f"Model {model_name} not found at {path}", file=sys.stderr)
    print("Downloading...", file=sys.stderr)
    os.makedirs(MODEL_DIR, exist_ok=True)
    url = f"https://huggingface.co/ggerganov/whisper.cpp/resolve/main/{model_name}"
    result = subprocess.run(["wget", "-q", "--show-progress", "-O", path, url])
    if result.returncode != 0:
        if os.path.exists(path):
            os.remove(path)
        print(f"Failed to download model from {url}", file=sys.stderr)
        sys.exit(1)
    print(f"Downloaded {path}", file=sys.stderr)
    return path


def parse_args():
    p = argparse.ArgumentParser(description="whisper-anywhere voice dictation daemon")
    p.add_argument("--hotkey", default=None,
                    help="Single key like KEY_F12. Omit for Ctrl+Super+Space combo.")
    p.add_argument("--model", default=None,
                    help=f"Model filename (default: {DEFAULT_MODEL})")
    return p.parse_args()


def load_config():
    cfg_path = os.path.join(CONFIG_DIR, "config")
    cfg = {}
    if os.path.exists(cfg_path):
        with open(cfg_path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    k, _, v = line.partition("=")
                    cfg[k.strip()] = v.strip()
    return cfg


def handler(signum, frame):
    raise SystemExit(0)


def keys_held(held):
    return bool(held & CTRL) and bool(held & SUPER) and bool(held & SPACE)


async def transcribe(proc, model_path):
    proc.terminate()
    await asyncio.get_event_loop().run_in_executor(None, proc.wait)
    result = await asyncio.get_event_loop().run_in_executor(
        None,
        lambda: subprocess.run(
            ["whisper-cli", "-m", model_path, "-f", AUDIO, "-otxt", "-nt"],
            capture_output=True, text=True,
        ),
    )
    text = " ".join(result.stdout.strip().split())
    if text and text != "[BLANK_AUDIO]":
        subprocess.run(["ydotool", "type", text])


async def run_daemon(hotkey_code, model_path):
    dev = find_keyboard()
    held = set()
    proc = None

    async for event in dev.async_read_loop():
        if event.type != ecodes.EV_KEY:
            continue

        if hotkey_code is None:
            if event.code not in WANTED_MODS:
                continue
            if event.value == 1:
                held.add(event.code)
                if keys_held(held) and proc is None:
                    proc = subprocess.Popen(
                        ["parec", "--format=s16le", "--rate=16000",
                         "--channels=1", "--file-format=wav", AUDIO],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    )
            elif event.value == 0:
                held.discard(event.code)
                if proc is not None:
                    await transcribe(proc, model_path)
                    proc = None
        else:
            if event.code != hotkey_code:
                continue
            if event.value == 1 and proc is None:
                proc = subprocess.Popen(
                    ["parec", "--format=s16le", "--rate=16000",
                     "--channels=1", "--file-format=wav", AUDIO],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
            elif event.value == 0 and proc is not None:
                await transcribe(proc, model_path)
                proc = None


def main():
    signal.signal(signal.SIGINT, handler)
    signal.signal(signal.SIGTERM, handler)

    args = parse_args()
    cfg = load_config()

    hotkey_arg = args.hotkey or cfg.get("hotkey")
    hotkey_code = None
    if hotkey_arg:
        hotkey_code = getattr(ecodes, hotkey_arg, None)
        if hotkey_code is None:
            print(f"Unknown key: {hotkey_arg}", file=sys.stderr)
            sys.exit(1)
        mode_str = f"single-key ({hotkey_arg})"
    else:
        mode_str = "combo (Ctrl+Super+Space)"

    model_name = args.model or cfg.get("model", DEFAULT_MODEL)
    check_deps()
    model_path = resolve_model(model_name)

    print(f"whisper-anywhere ready — mode: {mode_str}", file=sys.stderr)
    asyncio.run(run_daemon(hotkey_code, model_path))


if __name__ == "__main__":
    main()
